# Dev.to Mirror Environment Variables
# Copy this file to .env and fill in your values

# Your Dev.to username (required)
DEVTO_USERNAME=your-username

# Where the site is served (one required). SITE_DOMAIN wins when both are set.
# SITE_DOMAIN=example.com
GH_USERNAME=your-username

# Optional: ignore posts_data.json and refetch every article (true/false)
FORCE_FULL_REGEN=false
